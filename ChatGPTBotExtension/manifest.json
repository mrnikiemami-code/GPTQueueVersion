{
  "manifest_version": 3,
  "name": "ChatGPT Bot Bridge",
  "version": "0.3.0",
  "description": "ChatGPT Telegram Bot Bridge",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8767/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/chatgpt.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
